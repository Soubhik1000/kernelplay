{
  "name": "kernelplay-js",
  "version": "0.5.1",
  "description": "A lightweight JavaScript 2D/3D game engine inspired by Unity's component system.",
  "type": "module",

  "main": "dist/kernelplay.umd.js",
  "module": "dist/kernelplay.es.js",

  "exports": {
    ".": {
      "import": "./dist/kernelplay.es.js",
      "require": "./dist/kernelplay.umd.js"
    }
  },

  "files": ["dist", "README.md", "LICENSE"],

  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soubhik1000/kernelplay.git"
  },
  "homepage": "https://soubhik-rjs.github.io/kernelplay-js-demo/docs/",
  "bugs": {
    "url": "https://github.com/Soubhik1000/kernelplay/issues"
  },

  "keywords": [
    "game-engine", "2d", "3d", "javascript", "ecs",
    "canvas", "pixi", "threejs", "unity-like"
  ],
  "author": "Soubhik Mukherjee",
  "license": "MIT",
  "devDependencies": {
    "vite": "^5.4.0",
    "terser": "^5.19.0"
  }
}